# Your Resend API key. Create one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# The address the email is sent from.
# Before you verify a domain, use onboarding@resend.dev.
# After you verify one, use something on it, e.g. billing@yourdomain.com
RESEND_FROM=onboarding@resend.dev

# Where replies go. The email tells the customer a person reads replies, so this
# has to be a mailbox someone actually reads. Defaults to RESEND_FROM if unset.
# RESEND_REPLY_TO=support@yourdomain.com

# Optional. If set, the email includes a line linking to the source repository.
# REPO_URL=https://github.com/iDansV32/resend-billing-email
